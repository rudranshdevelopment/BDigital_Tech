# ==============================================================================
# BDigital Tech - Environment Variables Configuration Template
# Copy this file to .env and customize values for your deployment
# In Coolify: Add these under Project -> Environment Variables
# ==============================================================================

# Server Network Configuration (Defaults to 80 in Docker production)
PORT=80
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (MongoDB)
# In Docker Compose (using bundled service): mongodb://mongo:27017/bdigital_tech
# In Coolify (standalone service / external): mongodb+srv://<user>:<password>@cluster.mongodb.net/bdigital_tech
# Note: If database is unreachable, the application gracefully uses built-in in-memory fallback data.
MONGO_URI=mongodb://mongo:27017/bdigital_tech

# WhatsApp Contact Routing (Country code + phone number, no '+' or spaces)
WHATSAPP_PHONE=917709629488
